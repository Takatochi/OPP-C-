## ------------------------------------------
## .gitignore для C# / .NET / Visual Studio
## ------------------------------------------

# Вихідні збірки та тимчасові файли
bin/
obj/
out/
[Bb]uild/
[Ll]og/

# Кеш VS та користувацькі налаштування
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Тимчасові файли компілятора
*.pdb
*.cache
*.ilk
*.obj
*.tmp
*.log
*.vspscc
*.vssscc

# Пакети NuGet
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json

# Конфігураційні файли IDE
.idea/
.vscode/
*.swp
*.bak

# Автоматично згенеровані файли
Generated_Code/
GeneratedFiles/
*.designer.cs
*.g.i.cs
*_i.c
*_p.c

# Тести / покриття
TestResult.xml
TestResults/
*.coverage
*.coveragexml

# Секрети та тимчасові ключі
*.key
*.pfx
*.snk
appsettings.Development.json
appsettings.Local.json
secrets.json

# Публікації
publish/
dist/
*.publish.xml
*.pubxml
*.pubxml.user

# Кеши / резервні копії
*.dbmdl
*.bak
*.old
*.orig
*.tmp

# Системні файли
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Rider / JetBrains
.idea/
*.DotSettings.user

# Windows файли
*.lnk
